{
  "name": "vue-admin-paper-dashboard",
  "version": "1.0.0",
  "description": "A sample admin dashboard based on paper dashboard UI template",
  "author": "cristian.jora <cristian.jora@corebuild.eu>",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development webpack serve --config build/webpack.dev.conf.js",
    "dev:test": "cross-env NODE_ENV=development webpack serve --no-open --config build/webpack.dev.conf.js",
    "build": "cross-env NODE_ENV=production node build/build.js",
    "lint": "eslint --ext .js,.vue --format node_modules/eslint-friendly-formatter src",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "test": "npm run e2e"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "overrides": {
    "fsevents": "^2.3.3"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "axios": "^0.24.0",
    "bootstrap": "^3.3.7",
    "chartist": "^0.10.1",
    "es6-promise": "^4.2.8",
    "v-click-outside": "0.0.8",
    "vue": "^2.6.14",
    "vue-router": "^2.2.0",
    "vue2-simplert": "^0.5.8",
    "vuex": "^3.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/plugin-transform-runtime": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "@playwright/test": "^1.62.1",
    "autoprefixer": "^10.4.21",
    "babel-loader": "^9.2.1",
    "chalk": "^1.1.3",
    "cross-env": "^7.0.3",
    "css-loader": "^6.11.0",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "eslint": "^3.19.0",
    "eslint-config-standard": "^10.2.1",
    "eslint-friendly-formatter": "^3.0.0",
    "eslint-plugin-html": "^2.0.3",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-node": "^4.2.2",
    "eslint-plugin-promise": "^3.5.0",
    "eslint-plugin-standard": "^3.0.1",
    "html-webpack-plugin": "^5.6.4",
    "mini-css-extract-plugin": "^2.9.4",
    "ora": "^1.1.0",
    "postcss": "^8.5.6",
    "postcss-loader": "^7.3.4",
    "sass": "~1.79.0",
    "sass-loader": "^14.2.1",
    "semver": "^5.7.1",
    "shelljs": "^0.7.6",
    "vue-loader": "^15.11.1",
    "vue-style-loader": "^4.1.3",
    "vue-template-compiler": "^2.6.14",
    "webpack": "^5.101.3",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.2",
    "webpack-merge": "^5.10.0"
  },
  "engines": {
    "node": ">= 18.0.0",
    "npm": ">= 9.0.0"
  }
}
